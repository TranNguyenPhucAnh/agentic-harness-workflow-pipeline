MINIMAX_SCOPE_PATTERNS: list[re.Pattern[str]] = [
    re.compile(r"^src/hooks/"),
    re.compile(r"^src/data/"),
    re.compile(r"^src/types/"),
    re.compile(r"^src/utils/"),
